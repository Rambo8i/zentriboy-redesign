---
/**
 * Hero mit Laufrad zwischen zwei Schriftebenen (Startseite „ZENTRIERT“, ZentriBoy-Seite).
 * Zwei sticky Ebenen, damit das 3D-Laufrad (feste WebGL-Bühne, z 5) dazwischen liegt:
 *   hinten  (z auto): gefülltes Wort + Laufrad-Anker
 *   vorne   (z 6):    Wort als Kontur, Fuß (Slot), Messuhr
 * Beim Scrollen wird das Rad zentriert: Seitenschlag → 0, Buchstaben richten sich aus.
 */
import WheelAnchor from '../ui/WheelAnchor.astro';
import DialGauge from '../ui/DialGauge.astro';

interface Props {
  word: string;
  /** Unsichtbarer, sinnvoller Text der h1 für Screenreader und Suchmaschinen */
  title: string;
  theme?: 'paper' | 'graphite';
  view?: 'hero' | 'product';
  variant?: 'home' | 'product';
}

const { word, title, theme = 'paper', view = 'hero', variant = 'home' } = Astro.props;
const letters = word.split('');
---

<section class={`hero hero--${variant}`} data-theme={theme} data-module="hero" style={`--letters:${letters.length}`}>
  <div class="hero__back">
    <h1 class="hero__title">
      <span class="visually-hidden">{title}</span>
      <span class="hero__word hero__word--fill" aria-hidden="true">
        {
          letters.map((l) => (
            <span class="hero__char">
              <span class="hero__char-rise">
                <span class="hero__char-in">{l}</span>
              </span>
            </span>
          ))
        }
      </span>
    </h1>
    <div class="hero__anchor">
      <WheelAnchor view={view} probe />
    </div>
  </div>

  <div class="hero__front">
    <span class="hero__word hero__word--line" aria-hidden="true">
      {
        letters.map((l) => (
          <span class="hero__char">
            <span class="hero__char-rise">
              <span class="hero__char-in">{l}</span>
            </span>
          </span>
        ))
      }
    </span>

    <div class="hero__foot">
      <slot />
    </div>

    <div class="hero__gauge" aria-hidden="true">
      <div class="hero__dial">
        <DialGauge counter={false} />
      </div>
      <dl class="hero__readout">
        <dt class="t-mono t-muted">Seitenschlag</dt>
        <dd class="hero__value t-num" data-readout>&plusmn;0,00 mm</dd>
        <dd class="hero__status t-mono" data-status>Nicht zentriert</dd>
      </dl>
    </div>

    <svg class="hero__probe" aria-hidden="true" focusable="false">
      <line x1="0" y1="0" x2="0" y2="0"></line>
      <circle r="5" cx="0" cy="0"></circle>
    </svg>
  </div>
</section>

<style>
  .hero {
    /* Schriftgröße so, dass das Wort die Zeile füllt (gemessen: ZENTRIERT 7,21 em, ZENTRIBOY 7,39 em bei 125 %) */
    --fit: calc(var(--letters) * 0.83);
    position: relative;
    height: 100svh;
  }

  :global(.motion-ok) .hero {
    height: 200svh;
  }

  .hero__back,
  .hero__front {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
  }

  .hero__front {
    z-index: var(--z-above-stage);
    margin-top: calc(-1 * max(100svh, 34rem));
    pointer-events: none;
  }

  .hero__front > * {
    pointer-events: auto;
  }

  .hero__title {
    position: absolute;
    inset: 0;
  }

  .hero__word {
    position: absolute;
    left: var(--margin);
    right: var(--margin);
    top: 44%;
    display: flex;
    justify-content: space-between;
    transform: translateY(-50%);
    font-size: calc((100vw - 2 * var(--margin)) / var(--fit));
    font-stretch: 125%;
    font-weight: 830;
    line-height: 0.78;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    user-select: none;
  }

  .hero__word--line {
    color: transparent;
    -webkit-text-stroke: 1.25px var(--fg);
    pointer-events: none !important;
  }

  .hero__char,
  .hero__char-rise {
    display: inline-block;
  }

  .hero__char-in {
    display: inline-block;
    will-change: transform;
  }

  /* Startzustand für den Einstieg (nur mit JS und erlaubter Bewegung) */
  :global(.motion-ok:not(.app-failed)) .hero:not(:global(.is-in)) .hero__char {
    clip-path: inset(-45% -25% -24% -25%);
  }

  :global(.motion-ok:not(.app-failed)) .hero:not(:global(.is-in)) .hero__char-rise {
    transform: translateY(145%);
  }

  /* Zentriert über Ränder: Den Transform (Skalierung beim Zentrieren) besitzt GSAP. */
  .hero__anchor {
    --aw: min(82svh, 62vw);
    position: absolute;
    left: 58%;
    top: 46%;
    width: var(--aw);
    margin: calc(var(--aw) / -2) 0 0 calc(var(--aw) / -2);
  }

  .hero__foot {
    position: absolute;
    left: var(--margin);
    bottom: clamp(1.5rem, 4.5svh, 3.25rem);
    display: grid;
    gap: 1.6rem;
    max-width: 30rem;
  }

  .hero__foot :global(.hero__sub) {
    font-size: clamp(1.1rem, 0.7vw + 0.8rem, 1.45rem);
  }

  .hero__foot :global(.hero__links) {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.25rem;
  }

  .hero__gauge {
    position: absolute;
    right: var(--margin);
    bottom: clamp(1.5rem, 4.5svh, 3.25rem);
    display: flex;
    align-items: flex-end;
    gap: 1.1rem;
  }

  .hero__dial {
    width: clamp(5.5rem, 8vw, 8rem);
  }

  .hero__readout {
    display: grid;
    gap: 0.3rem;
    min-width: 10.5rem;
  }

  .hero__value {
    font-size: clamp(1.5rem, 2.2vw, 2.25rem);
    line-height: 1;
  }

  .hero__status {
    color: var(--fg-muted);
    transition: color 0.4s;
  }

  .hero__status:global(.is-true) {
    color: var(--accent-text);
  }

  .hero__probe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none !important;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .hero__probe:global(.is-on) {
    opacity: 1;
  }

  .hero__probe line {
    stroke: var(--fg);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }

  .hero__probe circle {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  /* Produktvariante: Name unten, Rad rechts angeschnitten */
  .hero--product .hero__word {
    top: auto;
    bottom: 30%;
    transform: none;
  }

  .hero--product .hero__anchor {
    --aw: min(86svh, 62vw);
    left: 64%;
    top: 50%;
  }

  @media (max-width: 1023px) {
    .hero {
      /* gemessen: 4,02–4,11 em bei 62 % Breite */
      --fit: calc(var(--letters) * 0.475);
    }

    .hero__word {
      top: 36%;
      font-stretch: 62%;
      font-weight: 800;
    }

    .hero__anchor {
      --aw: min(128vw, 74svh);
      left: 74%;
      top: 47%;
    }

    .hero__gauge {
      top: calc(var(--header-h) + 0.5rem);
      bottom: auto;
      gap: 0.75rem;
    }

    .hero__dial {
      width: 4rem;
    }

    .hero__readout {
      min-width: 0;
    }

    .hero__value {
      font-size: 1.25rem;
    }

    .hero__foot {
      right: var(--margin);
      max-width: none;
    }

    .hero--product .hero__word {
      top: 36%;
      bottom: auto;
    }

    .hero--product .hero__anchor {
      --aw: min(128vw, 74svh);
      left: 70%;
      top: 47%;
    }
  }
</style>
