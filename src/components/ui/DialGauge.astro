---
/**
 * Messuhr als SVG, serverseitig gerechnet (keine Client-Last).
 * Skala 0–50–0 wie bei einer Messuhr für Plus/Minus-Abweichungen, 100 Teilstriche,
 * zwei rote Toleranzmarken, kleiner Umdrehungszähler. Die Nadel dreht per CSS-Variable
 * `--angle` (gesetzt von den Modulen dial, hero, preloader).
 */
interface Props {
  class?: string;
  /** Messbolzen unten anzeigen (Produktansicht) */
  stem?: boolean;
  counter?: boolean;
  tolerance?: boolean;
  unit?: string;
}

const { class: cls = '', stem = false, counter = true, tolerance = true, unit = '0,01 mm' } = Astro.props;

const r = (n: number) => Math.round(n * 100) / 100;
const polar = (radius: number, i: number, of: number) => {
  const a = (i / of) * Math.PI * 2 - Math.PI / 2;
  return { x: r(Math.cos(a) * radius), y: r(Math.sin(a) * radius) };
};

const ticks = Array.from({ length: 100 }, (_, i) => {
  const kind = i % 10 === 0 ? 'l' : i % 5 === 0 ? 'm' : 's';
  const inner = kind === 'l' ? 73 : kind === 'm' ? 77.5 : 80.5;
  const a = polar(86, i, 100);
  const b = polar(inner, i, 100);
  return { x1: a.x, y1: a.y, x2: b.x, y2: b.y, kind };
});

const numbers = [0, 10, 20, 30, 40, 50, 40, 30, 20, 10].map((n, i) => {
  const p = polar(62.5, i, 10);
  return { n, x: p.x, y: r(p.y + 3.4) };
});

const counterTicks = Array.from({ length: 10 }, (_, i) => {
  const a = polar(12.5, i, 10);
  const b = polar(i % 5 === 0 ? 9 : 10.5, i, 10);
  return { x1: a.x, y1: a.y, x2: b.x, y2: b.y };
});

// Toleranzmarken bei ±10 Teilstrichen (±36°)
const tol = [-36, 36].map((deg) => {
  const a = ((deg - 90) * Math.PI) / 180;
  const tip = { x: r(Math.cos(a) * 88), y: r(Math.sin(a) * 88) };
  const baseR = 97;
  const w = 0.045;
  const b1 = { x: r(Math.cos(a - w) * baseR), y: r(Math.sin(a - w) * baseR) };
  const b2 = { x: r(Math.cos(a + w) * baseR), y: r(Math.sin(a + w) * baseR) };
  return `M${tip.x} ${tip.y}L${b1.x} ${b1.y}L${b2.x} ${b2.y}Z`;
});

const viewBox = stem ? '-104 -104 208 300' : '-104 -104 208 208';
---

<svg class={`dial ${cls}`} viewBox={viewBox} aria-hidden="true" focusable="false">
  {
    stem && (
      <g class="dial__stem">
        <rect x="-9" y="98" width="18" height="30" />
        <rect x="-5" y="128" width="10" height="46" />
        <rect x="-2.2" y="174" width="4.4" height="12" class="dial__plunger" />
        <circle cx="0" cy="189" r="3.2" class="dial__tip" />
      </g>
    )
  }
  <circle class="dial__bezel" r="100"></circle>
  <circle class="dial__bezel-inner" r="93"></circle>
  <circle class="dial__face" r="89"></circle>
  <g class="dial__ticks">
    {ticks.map((t) => <line class={`dial__tick dial__tick--${t.kind}`} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
  </g>
  <g class="dial__numbers">
    {
      numbers.map((n) => (
        <text x={n.x} y={n.y} text-anchor="middle">
          {n.n}
        </text>
      ))
    }
  </g>
  <text class="dial__unit" x="0" y="-27" text-anchor="middle">{unit}</text>
  <text class="dial__sign" x="13" y="-45" text-anchor="middle">+</text>
  <text class="dial__sign" x="-13" y="-45" text-anchor="middle">&minus;</text>
  {tolerance && <g class="dial__tol">{tol.map((d) => <path d={d} />)}</g>}
  {
    counter && (
      <g class="dial__counter" transform="translate(0 34)">
        <circle r="14.5" class="dial__counter-ring" />
        {counterTicks.map((t) => (
          <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />
        ))}
        <g class="dial__counter-needle">
          <path d="M-0.9 2 L0 -10.5 L0.9 2 Z" />
        </g>
        <circle r="1.6" class="dial__counter-cap" />
      </g>
    )
  }
  <g class="dial__needle">
    <path d="M-1.8 16 L-0.55 -84 L0.55 -84 L1.8 16 Z"></path>
    <circle cy="12" r="5.2"></circle>
  </g>
  <circle class="dial__cap" r="4.2"></circle>
  <circle class="dial__cap-dot" r="1.4"></circle>
</svg>

<style>
  .dial {
    --angle: 0deg;
    --counter-angle: 0deg;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--fg);
  }

  .dial__bezel {
    fill: var(--bg-2);
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .dial__bezel-inner {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
    opacity: 0.55;
  }

  .dial__face {
    fill: var(--bg);
    stroke: currentColor;
    stroke-width: 0.5;
    opacity: 1;
  }

  .dial__tick {
    stroke: currentColor;
    stroke-linecap: butt;
  }

  .dial__tick--l {
    stroke-width: 1.3;
  }

  .dial__tick--m {
    stroke-width: 0.9;
  }

  .dial__tick--s {
    stroke-width: 0.55;
  }

  .dial__numbers text,
  .dial__unit,
  .dial__sign {
    fill: currentColor;
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .dial__numbers text {
    font-size: 9.5px;
    letter-spacing: -0.02em;
  }

  .dial__unit {
    font-size: 6.5px;
    letter-spacing: 0.04em;
    opacity: 0.75;
  }

  .dial__sign {
    font-size: 8px;
    opacity: 0.75;
  }

  .dial__tol path {
    fill: var(--accent);
  }

  .dial__counter-ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.6;
  }

  .dial__counter line {
    stroke: currentColor;
    stroke-width: 0.6;
  }

  /* Drehpunkt (0,0) liegt bei 50 % / 84 % der Nadel-Bounding-Box (Pfad von y −10,5 bis 2). */
  .dial__counter-needle {
    transform: rotate(var(--counter-angle));
    transform-origin: 50% 84%;
    transform-box: fill-box;
  }

  .dial__counter-needle path,
  .dial__counter-cap {
    fill: currentColor;
  }

  .dial__needle {
    transform: rotate(var(--angle));
    transform-origin: 0 0;
    transform-box: view-box;
  }

  .dial__needle path {
    fill: var(--accent);
  }

  .dial__needle circle {
    fill: var(--accent);
    opacity: 0.9;
  }

  .dial__cap {
    fill: currentColor;
  }

  .dial__cap-dot {
    fill: var(--bg);
  }

  .dial__stem rect {
    fill: var(--bg-2);
    stroke: currentColor;
    stroke-width: 1.2;
  }

  .dial__stem .dial__plunger {
    fill: currentColor;
  }

  .dial__tip {
    fill: var(--accent);
  }
</style>
