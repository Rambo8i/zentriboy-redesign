---
/**
 * Platzhalter für das 3D-Laufrad. Die WebGL-Bühne liest Position und Größe dieses Elements.
 * Enthält eine statische SVG-Zeichnung als Rückfall (ohne JS, ohne WebGL, beim Laden).
 */
interface Props {
  view?: 'hero' | 'product' | 'side' | 'front';
  scale?: number;
  probe?: boolean;
  class?: string;
}

const { view = 'hero', scale = 1, probe = false, class: cls = '' } = Astro.props;

const r = (n: number) => Math.round(n * 100) / 100;
const spokes = Array.from({ length: 32 }, (_, i) => {
  const k = Math.floor(i / 2);
  const rimA = (i / 32) * Math.PI * 2;
  const hubA = rimA + (k % 2 === 0 ? 1 : -1) * ((3 * Math.PI * 2) / 16);
  return {
    x1: r(Math.cos(hubA) * 9),
    y1: r(Math.sin(hubA) * 9),
    x2: r(Math.cos(rimA) * 93.5),
    y2: r(Math.sin(rimA) * 93.5),
  };
});
---

<div
  class={`wheel-anchor ${cls}`}
  data-wheel-anchor
  data-wheel-view={view}
  data-wheel-scale={scale}
  data-wheel-probe={probe ? '' : undefined}
  aria-hidden="true"
>
  <svg
    class="wheel-fallback"
    viewBox="-110 -110 220 220"
    focusable="false"
    style={`inset: ${r((1 - scale) * 50)}%; width: ${r(scale * 100)}%; height: ${r(scale * 100)}%;`}
  >
    <circle r="104.5" class="wf-tire"></circle>
    <circle r="100" class="wf-rim"></circle>
    <circle r="93.5" class="wf-rim wf-rim--in"></circle>
    {spokes.map((s) => <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} class="wf-spoke" />)}
    <circle r="10" class="wf-hub"></circle>
  </svg>
</div>

<style>
  .wheel-anchor {
    position: relative;
    aspect-ratio: 1;
    pointer-events: none;
  }

  .wheel-fallback {
    position: absolute;
    transition: opacity 0.6s var(--ease-out);
  }

  :global(.webgl-ready) .wheel-fallback {
    opacity: 0;
  }

  .wf-tire {
    fill: none;
    stroke: var(--fg);
    stroke-width: 6;
  }

  .wf-rim {
    fill: none;
    stroke: var(--fg-muted);
    stroke-width: 1.5;
  }

  .wf-rim--in {
    stroke-width: 0.8;
  }

  .wf-spoke {
    stroke: var(--fg-muted);
    stroke-width: 0.6;
  }

  .wf-hub {
    fill: var(--bg-2);
    stroke: var(--fg-muted);
    stroke-width: 1;
  }
</style>
