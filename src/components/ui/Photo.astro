---
/**
 * Werkstattfoto: responsive (AVIF/WebP), lazy, entsättigt bis zur Interaktion.
 * Die Originale sind 640 px breit – es wird nie hochskaliert ausgeliefert.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  ratio?: string;
  reveal?: boolean;
  parallax?: string;
  color?: boolean;
}

const {
  image,
  alt,
  sizes = '(min-width: 1024px) 40vw, 90vw',
  loading = 'lazy',
  class: cls = '',
  ratio,
  reveal = false,
  parallax,
  color = false,
} = Astro.props;

// Nie größer ausliefern als das Original (Werkstattfotos 640 px, Produktfotos 250 px)
const fitting = [320, 480, 640].filter((w) => w <= image.width);
const widths = fitting.length ? fitting : [image.width];
---

<figure
  class={`photo ${color ? 'is-color' : ''} ${cls}`}
  style={ratio ? `aspect-ratio: ${ratio}` : undefined}
  data-reveal={reveal ? 'clip' : undefined}
>
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    loading={loading}
    decoding="async"
    data-parallax={parallax}
  />
  <slot />
</figure>
