---
/**
 * Schriftfeld: der Zeichnungskopf einer technischen Zeichnung als Footer.
 * Die Haarlinien ordnen echten Inhalt (Firma, Anschrift, Kontakt, Recht, Blatt).
 */
import Mark from '../ui/Mark.astro';
import Icon from '../ui/Icon.astro';
import { company, labelForPath } from '@/data/site';

interface Props {
  theme: 'paper' | 'graphite';
}

const { theme } = Astro.props;
const sheet = labelForPath(Astro.url.pathname);
const year = new Date().getFullYear();
---

<footer class="sf" data-theme={theme} data-module="footer">
  <div class="sf__table">
    <div class="sf__cell sf__cell--firm">
      <span class="sf__label">Firma</span>
      <p class="sf__firm">
        <Mark size="clamp(2rem, 3.2vw, 3rem)" />
        <span>Braun <span class="sf__legal">GmbH</span></span>
      </p>
      <p class="sf__services">{company.services.join(', ')}</p>
    </div>

    <div class="sf__cell">
      <span class="sf__label">Anschrift</span>
      <address class="sf__value">
        {company.street}<br />
        {company.postalCode} {company.city}<br />
        {company.country}
      </address>
    </div>

    <div class="sf__cell">
      <span class="sf__label">Telefon, Fax</span>
      <p class="sf__value">
        <a href={company.phone.href}>{company.phone.display}</a><br />
        <span>Fax {company.fax.display}</span>
      </p>
    </div>

    <div class="sf__cell">
      <span class="sf__label">E-Mail</span>
      <p class="sf__value"><a href={`mailto:${company.email}`} data-cursor="mail">{company.email}</a></p>
    </div>

    <div class="sf__cell">
      <span class="sf__label">Rechtliches</span>
      <p class="sf__value sf__legal-links">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
      </p>
    </div>

    <div class="sf__cell">
      <span class="sf__label">Blatt</span>
      <p class="sf__value">{sheet}</p>
    </div>

    <div class="sf__cell sf__cell--top">
      <button class="sf__top" type="button" data-to-top>
        <span>Nach oben</span>
        <Icon name="arrow-up" size="1.1em" />
      </button>
    </div>
  </div>
  <p class="sf__copy t-mono">&copy; {year} {company.name}</p>
</footer>

<style>
  .sf {
    position: relative;
    z-index: var(--z-above-stage);
    padding: clamp(4rem, 8vw, 7rem) var(--margin) calc(1.5rem + env(safe-area-inset-bottom));
  }

  .sf__table {
    display: grid;
    grid-template-columns: 5fr 3fr 2.4fr 2.6fr;
    grid-template-rows: auto auto;
    border: 1px solid var(--line-strong);
  }

  .sf__cell {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 7.5rem;
    padding: 1rem 1.1rem 1.2rem;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .sf__cell--firm {
    grid-row: span 2;
    justify-content: space-between;
  }

  .sf__cell:nth-child(4),
  .sf__cell--top {
    border-right: 0;
  }

  .sf__cell:nth-child(5),
  .sf__cell:nth-child(6),
  .sf__cell--top {
    border-bottom: 0;
  }

  .sf__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .sf__firm {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-stretch: 125%;
    font-weight: 820;
    font-size: clamp(2.25rem, 4.6vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .sf__legal {
    font-family: var(--font-mono);
    font-size: 0.28em;
    font-weight: 400;
    letter-spacing: 0.04em;
    vertical-align: 0.35em;
  }

  .sf__services {
    max-width: 34ch;
    color: var(--fg-muted);
    font-size: var(--fs-small);
  }

  .sf__value {
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .sf__value a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-fast);
  }

  .sf__value a:hover {
    text-decoration-color: var(--accent);
  }

  .sf__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .sf__cell--top {
    justify-content: flex-end;
  }

  .sf__top {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    font-weight: 560;
  }

  .sf__top :global(.icon) {
    transition: transform 0.6s var(--ease-out);
  }

  .sf__top:hover :global(.icon) {
    transform: translateY(-0.25em);
  }

  .sf__copy {
    margin-top: 1rem;
    text-align: right;
    color: var(--fg-muted);
  }

  @media (max-width: 1023px) {
    .sf__table {
      grid-template-columns: 1fr 1fr;
    }

    .sf__cell--firm {
      grid-column: 1 / -1;
      grid-row: auto;
      border-right: 0;
    }

    .sf__cell {
      min-height: 6rem;
    }

    .sf__cell:nth-child(2n + 1) {
      border-right: 0;
    }

    .sf__cell:nth-child(4) {
      border-right: 1px solid var(--line-strong);
    }

    .sf__cell:nth-child(5),
    .sf__cell:nth-child(6) {
      border-bottom: 1px solid var(--line-strong);
    }

    .sf__cell:nth-child(6) {
      border-right: 1px solid var(--line-strong);
    }

    .sf__cell--top {
      grid-column: auto;
    }
  }
</style>
