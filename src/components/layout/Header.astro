---
import Mark from '../ui/Mark.astro';
import Menu from './Menu.astro';
import { nav } from '@/data/site';

interface Props {
  theme: 'paper' | 'graphite';
}

const { theme } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="header" data-module="header" data-on={theme}>
  <a href="/" class="header__brand" aria-label="Braun GmbH, zur Startseite" aria-current={path === '/' ? 'page' : undefined}>
    <Mark size="1.6rem" />
    <span class="header__name">Braun</span>
    <span class="header__legal">GmbH</span>
  </a>

  <nav class="header__nav" aria-label="Hauptnavigation">
    <ul role="list">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-hover-scramble>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <button class="header__toggle" type="button" aria-expanded="false" aria-controls="menu" data-magnetic="0.3">
    <span data-magnetic-inner>Menü</span>
  </button>
</header>

<Menu current={path} />

<style>
  .header {
    --hdr-fg: var(--c-ink);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-inline: var(--margin);
    color: var(--hdr-fg);
    transition:
      transform 0.7s var(--ease-out),
      color 0.35s linear;
  }

  .header[data-on='graphite'] {
    --hdr-fg: var(--c-light);
  }

  .header.is-hidden {
    transform: translateY(-110%);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    line-height: 1;
  }

  .header__name {
    font-stretch: 125%;
    font-weight: 820;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .header__legal {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    transform: translateY(0.1em);
  }

  .header__nav ul {
    display: flex;
    gap: clamp(1.25rem, 2.4vw, 2.75rem);
  }

  .header__nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 520;
    letter-spacing: -0.005em;
  }

  /* Unterstreichung läuft von links ein; die aktuelle Seite bleibt markiert */
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.3rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease-out);
  }

  .header__nav a:hover::after,
  .header__nav a:focus-visible::after,
  .header__nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__toggle {
    display: none;
    align-items: center;
    height: 2.75rem;
    padding-inline: 1.1rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 1023px) {
    .header__nav {
      display: none;
    }

    .header__toggle {
      display: inline-flex;
    }
  }
</style>
