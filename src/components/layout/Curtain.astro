---
/** Seitenblende (persistent über Seitenwechsel). Logik in lib/transitions.ts. */
---

<div class="curtain" transition:persist="curtain" aria-hidden="true">
  <div class="curtain__panel">
    <span class="curtain__cross curtain__cross--h"></span>
    <span class="curtain__cross curtain__cross--v"></span>
    <p class="curtain__label"></p>
  </div>
  <svg class="curtain__ring" width="100%" height="100%" focusable="false">
    <circle cx="0" cy="0" r="0"></circle>
  </svg>
  <span class="curtain__dot"></span>
</div>

<style>
  .curtain {
    position: fixed;
    inset: 0;
    z-index: var(--z-curtain);
    visibility: hidden;
    pointer-events: none;
  }

  .curtain:global(.is-active) {
    visibility: visible;
    pointer-events: auto;
  }

  .curtain__panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--c-graphite-2);
    color: var(--c-light);
    clip-path: circle(0 at 50% 50%);
  }

  .curtain__cross {
    position: absolute;
    background: var(--c-light);
    opacity: 0.14;
  }

  .curtain__cross--h {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }

  .curtain__cross--v {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }

  .curtain__label {
    position: relative;
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(2.5rem, 8vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .curtain__ring {
    position: absolute;
    inset: 0;
    overflow: visible;
  }

  .curtain__ring circle {
    fill: none;
    stroke: var(--c-signal-bright);
    stroke-width: 1.5;
  }

  .curtain:global(.is-expand) .curtain__ring {
    opacity: 0;
  }

  .curtain__dot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.75rem;
    height: 0.75rem;
    margin: -0.375rem 0 0 -0.375rem;
    border-radius: 50%;
    background: var(--c-signal-bright);
    transform: scale(0);
  }
</style>
