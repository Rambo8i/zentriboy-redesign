---
/**
 * CNC-Bearbeitung: Werkzeugbahn um das Sternteil (drei Schrupp-Bahnen, eine Schlichtbahn).
 * Die Bahn zeichnet sich, der Fräser folgt ihr, die Positionsanzeige (X/Y) läuft mit.
 */
import { offsetStar, starContour, toPath, type Pt } from '@/lib/geometry';

const cx = 400;
const cy = 262;
const R = 172;
const SAMPLES = 240;

const loops: Pt[][] = [48, 32, 16].map((d) => offsetStar(cx, cy, R, d, SAMPLES));
const finish = starContour(cx, cy, R, SAMPLES);

// Eine durchgehende Bahn: Anfahren von oben, Schleifen schließen, radial zustellen
const toolPoints: Pt[] = [{ x: cx, y: 18 }];
for (const loop of [...loops, finish]) {
  toolPoints.push(...loop, loop[0]);
}
const toolPath = toPath(toolPoints);
const partPath = toPath(finish, true);
---

<figure class="toolpath" data-visual="toolpath">
  <svg class="drawing" viewBox="0 0 800 520" role="img" aria-label="Werkzeugbahn einer CNC-Fräsbearbeitung um ein sternförmiges Werkstück">
    <rect class="d-hidden" x="96" y="18" width="608" height="488"></rect>
    <line class="d-axis" x1={cx} y1="4" x2={cx} y2="516"></line>
    <line class="d-axis" x1="80" y1={cy} x2="720" y2={cy}></line>
    <path class="d-thin t-part" d={partPath}></path>
    <path class="t-path" d={toolPath}></path>
    <g class="t-tool">
      <circle class="d-fill" r="11"></circle>
      <circle class="d-accent-fill" r="3"></circle>
    </g>
    <text class="d-label d-label--muted" x="104" y="38">Rohteil</text>
  </svg>
  <dl class="toolpath__dro t-num" aria-hidden="true">
    <div><dt>X</dt><dd data-dro-x>+0,000</dd></div>
    <div><dt>Y</dt><dd data-dro-y>+0,000</dd></div>
  </dl>
</figure>

<style>
  .toolpath {
    position: relative;
  }

  .t-path {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .toolpath__dro {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.2rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    font-size: 0.9375rem;
  }

  .toolpath__dro div {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
  }

  .toolpath__dro dt {
    color: var(--accent-text);
  }

  .toolpath__dro dd {
    min-width: 7ch;
    text-align: right;
  }
</style>
