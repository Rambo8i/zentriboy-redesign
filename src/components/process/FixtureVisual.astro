---
/**
 * Vorrichtungen: echtes Werkstattfoto (Sternteil in der Vorrichtung) mit Zeichnungs-Annotationen.
 * Die Punkte liegen auf sichtbaren Elementen des Fotos (640 × 480).
 */
import { Picture } from 'astro:assets';
import { workById } from '@/data/works';

const work = workById('0428');

const callouts = [
  { label: 'Werkstück', x: 350, y: 118, path: 'M350 118L420 52H600', tx: 426, ty: 44 },
  { label: 'Aufnahmeplatte', x: 158, y: 206, path: 'M158 206L110 150H36', tx: 36, ty: 142 },
  { label: 'Spanneisen', x: 268, y: 296, path: 'M268 296L196 404H40', tx: 40, ty: 396 },
  { label: 'Stufenblock', x: 507, y: 304, path: 'M507 304L548 402H612', tx: 470, ty: 432 },
];
---

<figure class="fixture" data-visual="fixture">
  <div class="fixture__photo photo">
    <Picture
      src={work.image}
      alt={work.alt}
      formats={['avif', 'webp']}
      widths={[320, 480, 640]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <svg class="drawing fixture__notes" viewBox="0 0 640 480" aria-hidden="true" focusable="false">
    {
      callouts.map((c) => (
        <g class="f-note">
          <path class="d-leader f-leader" d={c.path} />
          <circle class="d-dot f-dot" cx={c.x} cy={c.y} r="7" />
          <text class="d-label f-label" x={c.tx} y={c.ty}>
            {c.label}
          </text>
        </g>
      ))
    }
  </svg>
  <figcaption class="visually-hidden">{work.caption}</figcaption>
</figure>

<style>
  .fixture {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .fixture__photo {
    position: absolute;
    inset: 0;
  }

  .fixture__notes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: #f1f2ef;
  }

  .fixture__notes :global(.d-label) {
    paint-order: stroke;
    stroke: #111312;
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .fixture__notes :global(.d-dot) {
    fill: rgba(17, 19, 18, 0.35);
  }
</style>
