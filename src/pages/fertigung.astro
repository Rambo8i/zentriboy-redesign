---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import Photo from '@/components/ui/Photo.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import PunchVisual from '@/components/process/PunchVisual.astro';
import FixtureVisual from '@/components/process/FixtureVisual.astro';
import ToolpathVisual from '@/components/process/ToolpathVisual.astro';
import EdmVisual from '@/components/process/EdmVisual.astro';
import PantographVisual from '@/components/process/PantographVisual.astro';
import { processes } from '@/data/processes';
import { workById } from '@/data/works';
import { company, inquiryMail } from '@/data/site';

const p = Object.fromEntries(processes.map((x) => [x.id, x]));
const block = workById('0291');
const round = workById('0326');
const milling = workById('0289');
const clamped = workById('0296');
---

<BaseLayout
  title="Fertigung"
  description="Werkzeugbau, Vorrichtungen, CNC-Bearbeitung, Erodieren und Diaformschleifen: Fertigung nach Zeichnung bei der Braun GmbH in Fridingen an der Donau."
  theme="paper"
  footerTheme="graphite"
>
  <section class="fh wrap" aria-labelledby="fh-title">
    <h1 id="fh-title" class="fh__title t-mega" data-reveal="chars">Fertigung</h1>
    <p class="fh__lead t-lead" data-reveal="lines" data-reveal-delay="0.2">
      Nach Zeichnung und auf Maß: fünf Verfahren aus einer Werkstatt in Fridingen an der Donau.
    </p>
    <nav class="fh__index" aria-label="Verfahren auf dieser Seite">
      <ol role="list">
        {
          processes.map((x) => (
            <li>
              <a class="fh__link" href={`#${x.id}`}>
                <span class="fh__name">{x.name}</span>
                <span class="fh__short t-small t-muted">{x.short}</span>
                <Icon name="arrow-down" class="fh__icon" size="1.25rem" />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <div data-module="fertigung">
    <!-- Werkzeugbau -->
    <section id="werkzeugbau" class="blatt blatt--wzb" data-theme="paper" aria-labelledby="h-wzb">
      <div class="blatt__grid wrap">
        <div class="blatt__visual"><PunchVisual id="f-punch" /></div>
        <div class="blatt__copy">
          <h2 id="h-wzb" class="blatt__name" data-reveal="rise" set:html={p.werkzeugbau.display} />
          <p class="t-lead" data-reveal="lines" data-reveal-delay="0.1">{p.werkzeugbau.long}</p>
          <div class="blatt__photos">
            <figure>
              <Photo image={block.image} alt={block.alt} sizes="(min-width: 1024px) 16vw, 45vw" ratio="4 / 3" reveal />
              <figcaption class="t-mono t-muted">{block.caption}</figcaption>
            </figure>
            <figure>
              <Photo image={round.image} alt={round.alt} sizes="(min-width: 1024px) 16vw, 45vw" ratio="4 / 3" reveal />
              <figcaption class="t-mono t-muted">{round.caption}</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Vorrichtungen -->
    <section id="vorrichtungen" class="blatt blatt--vor" data-theme="paper" aria-labelledby="h-vor">
      <h2 id="h-vor" class="blatt__name blatt__name--huge wrap" data-reveal="rise" set:html={p.vorrichtungen.display} />
      <div class="blatt__stage">
        <div class="blatt__visual"><FixtureVisual /></div>
        <p class="blatt__plate t-lead" data-reveal="rise">{p.vorrichtungen.long}</p>
      </div>
    </section>

    <!-- CNC -->
    <section id="cnc" class="blatt blatt--cnc" data-theme="paper" aria-labelledby="h-cnc">
      <div class="blatt__grid wrap">
        <div class="blatt__copy">
          <h2 id="h-cnc" class="blatt__name" data-reveal="rise" set:html={p.cnc.display} />
          <p class="t-lead" data-reveal="lines" data-reveal-delay="0.1">{p.cnc.long}</p>
          <div class="blatt__photos">
            <figure>
              <Photo image={milling.image} alt={milling.alt} sizes="(min-width: 1024px) 16vw, 45vw" ratio="4 / 3" reveal />
              <figcaption class="t-mono t-muted">{milling.caption}</figcaption>
            </figure>
            <figure>
              <Photo image={clamped.image} alt={clamped.alt} sizes="(min-width: 1024px) 16vw, 45vw" ratio="4 / 3" reveal />
              <figcaption class="t-mono t-muted">{clamped.caption}</figcaption>
            </figure>
          </div>
        </div>
        <div class="blatt__visual"><ToolpathVisual /></div>
      </div>
    </section>

    <!-- Erodieren: hier wechselt die Seite in die Werkstatt -->
    <section id="erodieren" class="blatt blatt--ero" data-theme="graphite" aria-labelledby="h-ero">
      <span class="blatt__ghost" aria-hidden="true">{p.erodieren.name}</span>
      <div class="blatt__visual"><EdmVisual /></div>
      <div class="blatt__copy wrap">
        <h2 id="h-ero" class="blatt__name" data-reveal="rise">{p.erodieren.name}</h2>
        <p class="t-lead" data-reveal="lines" data-reveal-delay="0.1">{p.erodieren.long}</p>
      </div>
    </section>

    <!-- Diaformschleifen -->
    <section id="diaform" class="blatt blatt--dia" data-theme="graphite" aria-labelledby="h-dia">
      <div class="blatt__grid wrap">
        <div class="blatt__copy">
          <h2 id="h-dia" class="blatt__name" data-reveal="rise" set:html={p.diaform.display} />
          <p class="t-lead" data-reveal="lines" data-reveal-delay="0.1">{p.diaform.long}</p>
          <p class="t-mono t-muted blatt__hint">Den Taster mit der Maus führen</p>
        </div>
        <div class="blatt__visual"><PantographVisual /></div>
      </div>
    </section>
  </div>

  <section class="ask-drawing" data-theme="graphite" aria-labelledby="ask-title">
    <div class="wrap ask-drawing__inner">
      <h2 id="ask-title" class="t-display" data-reveal="lines">Haben Sie<br />eine Zeichnung?</h2>
      <div class="ask-drawing__side">
        <p class="t-lead t-muted" data-reveal="lines">
          Schicken Sie uns Zeichnung oder Muster, Stückzahl, Werkstoff und Wunschtermin. Wir melden uns bei Ihnen.
        </p>
        <ArrowLink href={inquiryMail} label="Anfrage senden" size="lg" cursor="mail" />
        <p class="t-small t-muted">Telefon <a class="text-link" href={company.phone.href}>{company.phone.display}</a>, Fax {company.fax.display}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Kopf mit Verfahrensindex */
  .fh {
    padding-block: calc(var(--header-h) + clamp(3rem, 8vw, 7rem)) clamp(4rem, 8vw, 7rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  /* „Fertigung“ misst 7,49 em (t-mega) */
  .fh__title {
    font-size: calc((100vw - 2 * var(--margin)) / 7.75);
  }

  .fh__lead {
    max-width: 30ch;
  }

  .fh__index ol {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  .fh__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem) auto;
    align-items: center;
    gap: 2rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line-strong);
  }

  /* Die Breitenachse der Schrift reagiert auf Zeiger und Fokus */
  .fh__name {
    font-size: clamp(2rem, 4.4vw, 4.75rem);
    font-weight: 720;
    font-stretch: 100%;
    line-height: 1;
    letter-spacing: -0.04em;
    transition:
      font-stretch 0.7s var(--ease-out),
      color 0.3s;
  }

  .fh__short {
    opacity: 0;
    transform: translateY(0.5rem);
    transition:
      opacity 0.4s,
      transform 0.6s var(--ease-out);
  }

  .fh__link :global(.fh__icon) {
    transition: transform 0.6s var(--ease-out);
  }

  .fh__link:hover .fh__name,
  .fh__link:focus-visible .fh__name {
    font-stretch: 125%;
    color: var(--accent-text);
  }

  .fh__link:hover .fh__short,
  .fh__link:focus-visible .fh__short {
    opacity: 1;
    transform: none;
  }

  .fh__link:hover :global(.fh__icon),
  .fh__link:focus-visible :global(.fh__icon) {
    transform: translateY(0.3rem);
  }

  /* Blätter */
  .blatt {
    position: relative;
    padding-block: clamp(6rem, 12vw, 11rem);
    overflow: hidden;
  }

  .blatt__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 3rem;
    align-items: center;
  }

  /* Weiche Trennstellen (&shy;) in den Namen: lange Wörter brechen sauber statt das Raster zu sprengen */
  .blatt__name {
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(2.25rem, 4.4vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin-bottom: 1.75rem;
    hyphens: manual;
    overflow-wrap: break-word;
  }

  .blatt__grid > * {
    min-width: 0;
  }

  .blatt__copy {
    display: grid;
    align-content: start;
    gap: 1.25rem;
  }

  .blatt__copy .t-lead {
    max-width: 34ch;
  }

  .blatt__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .blatt__photos figure {
    display: grid;
    gap: 0.5rem;
  }

  .blatt--wzb .blatt__visual {
    grid-column: 1 / span 7;
  }

  .blatt--wzb .blatt__copy {
    grid-column: 9 / -1;
  }

  .blatt--vor {
    background: var(--bg-2);
  }

  .blatt__name--huge {
    font-size: clamp(3rem, 10vw, 12rem);
  }

  .blatt__stage {
    position: relative;
    padding-inline: var(--margin);
  }

  .blatt--vor .blatt__visual {
    width: min(78vw, 130svh);
    margin-left: auto;
  }

  .blatt__plate {
    position: relative;
    z-index: 1;
    max-width: 30rem;
    margin-top: -7rem;
    padding: 1.75rem;
    background: var(--bg);
    border: 1px solid var(--line-strong);
  }

  .blatt--cnc .blatt__copy {
    grid-column: 1 / span 4;
  }

  .blatt--cnc .blatt__visual {
    grid-column: 6 / -1;
  }

  .blatt--ero {
    min-height: 100svh;
    display: grid;
    align-content: center;
  }

  .blatt__ghost {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    font-stretch: 125%;
    font-weight: 820;
    font-size: clamp(5rem, 17vw, 20rem);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--fg) 22%, transparent);
    pointer-events: none;
  }

  .blatt--ero .blatt__visual {
    position: relative;
    width: min(70svh, 46vw);
    margin: 0 auto;
  }

  .blatt--ero .blatt__copy {
    margin-top: 2rem;
  }

  .blatt--dia .blatt__copy {
    grid-column: 1 / span 4;
  }

  .blatt--dia .blatt__visual {
    grid-column: 5 / -1;
  }

  .blatt__hint {
    margin-top: 0.5rem;
  }

  .ask-drawing {
    padding-block: clamp(6rem, 12vw, 11rem);
    border-top: 1px solid var(--line);
  }

  .ask-drawing__inner {
    display: grid;
    grid-template-columns: 1fr minmax(0, 30rem);
    gap: 3rem;
    align-items: end;
  }

  .ask-drawing__side {
    display: grid;
    gap: 1.75rem;
  }

  @media (max-width: 1023px) {
    .fh__link {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .fh__short {
      display: none;
    }

    .blatt__grid > * {
      grid-column: 1 / -1 !important;
    }

    .blatt--vor .blatt__visual {
      width: 100%;
    }

    .blatt__plate {
      margin-top: 1.5rem;
    }

    .blatt--ero .blatt__visual {
      width: min(100%, 26rem);
    }

    .blatt__ghost,
    .blatt__hint {
      display: none;
    }

    .ask-drawing__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
