---
import LegalPage from '@/components/layout/LegalPage.astro';
import { company, legal } from '@/data/site';

// Fehlende Angaben nicht still weglassen, sondern bis zur Ergänzung sichtbar als Entwurf kennzeichnen.
const missing = [
  !company.register && 'Registergericht und Registernummer (Pflichtangabe für eine GmbH, § 5 Abs. 1 Nr. 4 DDG)',
  !company.vatId && 'Umsatzsteuer-Identifikationsnummer, falls vorhanden (§ 5 Abs. 1 Nr. 6 DDG)',
  !legal.consumerDispute && 'Hinweis zur Verbraucherstreitbeilegung, falls erforderlich (§ 36 VSBG)',
].filter(Boolean);
---

<LegalPage title="Impressum" description="Impressum der Braun GmbH, Württembergerstr. 14, 78567 Fridingen.">
  {
    missing.length > 0 && (
      <div class="note">
        <p>Entwurf: Folgende Angaben fehlen noch und werden von der Braun GmbH ergänzt:</p>
        <ul>
          {missing.map((m) => (
            <li>{m}</li>
          ))}
        </ul>
      </div>
    )
  }

  <h2>Angaben gemäß § 5 DDG</h2>
  <p>
    {company.name}<br />
    {company.street}<br />
    {company.postalCode} {company.city}<br />
    {company.country}
  </p>

  <h2>Vertretungsberechtigter Geschäftsführer</h2>
  <p>{company.managingDirector}</p>

  <h2>Kontakt</h2>
  <p>
    Telefon: <a href={company.phone.href}>{company.phone.display}</a><br />
    Fax: {company.fax.display}<br />
    E-Mail: <a href={`mailto:${company.email}`}>{company.email}</a><br />
    Internet: {company.web}
  </p>

  {
    company.register && (
      <Fragment>
        <h2>Registereintrag</h2>
        <p>
          Registergericht: {company.register.court}
          <br />
          Registernummer: {company.register.number}
        </p>
      </Fragment>
    )
  }

  {
    company.vatId && (
      <Fragment>
        <h2>Umsatzsteuer-Identifikationsnummer</h2>
        <p>{company.vatId}</p>
      </Fragment>
    )
  }

  {
    legal.consumerDispute && (
      <Fragment>
        <h2>Verbraucherstreitbeilegung</h2>
        <p>{legal.consumerDispute}</p>
      </Fragment>
    )
  }

  <h2>Haftungshinweis</h2>
  <p>
    Trotz sorgfältiger inhaltlicher Kontrolle übernehmen wir keine Haftung für die Inhalte externer Links. Für den Inhalt
    der verlinkten Seiten sind ausschließlich deren Betreiber verantwortlich.
  </p>
</LegalPage>
